# ============================================
# CONFIGURAÇÕES DO PROJETO
# ============================================

# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados
DB_PATH=./data/agenda.db

# WhatsApp
WHATSAPP_ENABLED=true

# Preços padrão
PRECO_MANICURE=40.00
PRECO_CILIOS=80.00
PRECO_COMBO=110.00

# Horário de funcionamento
HORA_ABERTURA=08:00
HORA_FECHAMENTO=20:00
INTERVALO_MIN=60

# ============================================
# SEGURANÇA & AUTENTICAÇÃO
# ============================================

# JWT Secrets (Mude para valores seguros em produção!)
JWT_SECRET=sua-chave-super-secreta-change-me
JWT_REFRESH_SECRET=sua-chave-refresh-change-me

# API Key (opcional)
API_KEY=

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=info

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ============================================
# FLASK (Backend Python)
# ============================================

FLASK_ENV=development
FLASK_DEBUG=true
FLASK_TESTING=false
HOST=127.0.0.1
PORT=5000

# Segurança Flask
SECRET_KEY=chave-secreta-padrao-mude-em-producao
CSRF_ENABLED=true

# Banco de dados Flask
# DB_PATH=./backend/data/agenda.db
# LOG_DIR=./backend/logs
LOG_LEVEL=INFO

# Horário (usado pelo Flask)
# HORA_ABERTURA=08:00
# HORA_FECHAMENTO=20:00
# INTERVALO_MIN=60

# WhatsApp wa.me (integração por link)
WHATSAPP_BASE=https://wa.me
WHATSAPP_DDI=55

